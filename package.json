{
  "name": "omegas-dev",
  "version": "0.1.4",
  "description": "Open-source viewer and transfer tool for personal Claude Code and Codex configs",
  "type": "module",
  "bin": {
    "omegas-dev": "bin/omegas-dev.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/OmegaAgent/omegas-dev#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OmegaAgent/omegas-dev.git"
  },
  "bugs": {
    "url": "https://github.com/OmegaAgent/omegas-dev/issues"
  },
  "author": "Noureddin Bakir",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check bin/omegas-dev.js && node --check src/*.js",
    "pack:dry-run": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run check"
  },
  "keywords": [
    "omegas",
    "claude-code",
    "codex",
    "mcp",
    "configuration",
    "migration",
    "developer-tools",
    "onboarding"
  ],
  "license": "MIT"
}
